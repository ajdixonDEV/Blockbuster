@page "/shared/new"
@attribute [Authorize]
@inject IMovieLibrary MovieLibrary
@inject ISharedPlaybackCoordinator Rooms
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Creating room · Blockbuster</PageTitle>
<section class="catalog-empty"><p>Creating shared room…</p></section>

@code {
    [SupplyParameterFromQuery(Name = "movie")] public Guid MovieId { get; set; }
    [SupplyParameterFromQuery(Name = "file")] public Guid MediaFileId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!Guid.TryParse(auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var profileId)) return;
        var movie = await MovieLibrary.GetAsync(MovieId, profileId);
        var version = movie?.Versions.FirstOrDefault(item => item.MediaFileId == MediaFileId && item.IsAvailable);
        if (movie is null || version is null) { Navigation.NavigateTo("/shared"); return; }
        var room = Rooms.CreateRoom(movie.Id, version.MediaFileId, movie.Title);
        Navigation.NavigateTo($"/shared/{room.RoomId}", replace: true);
    }
}
