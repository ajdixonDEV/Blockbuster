@page "/movies/{MovieId:guid}/play"
@attribute [Authorize]
@implements IAsyncDisposable
@inject IMovieLibrary MovieLibrary
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
<PageTitle>@(movie?.Title ?? "Player") · Blockbuster</PageTitle>
@if (movie is not null && version is not null)
{
    <section class="player-page">
        <a href="/movies/@MovieId" class="back-link">← @movie.Title</a>
        <div class="player-shell" id="movie-player">
            <video src="/media/@version.MediaFileId" preload="metadata">
            </video>
            <div class="player-status" aria-live="polite">
            </div>
            <div class="player-controls">
                <button data-action="play" aria-label="Play or pause">▶</button>
                <span data-current>0:00</span>
                <input data-seek type="range" min="0" max="1000" value="0" aria-label="Seek" />
                <span data-duration>0:00</span>
                <button data-action="mute" aria-label="Mute">🔊</button>
                <input data-volume type="range" min="0" max="1" step="0.05" value="1" aria-label="Volume" />
                <button data-action="fullscreen" aria-label="Fullscreen">⛶</button>
            </div>
        </div>
        <p class="player-help">Space: play/pause · ←/→: seek 10 seconds · M: mute · F: fullscreen</p>
    </section>
}
else
{
    <section class="catalog-empty">
        <p>This version is unavailable.</p>
    </section>
}
@code {
    [Parameter] public Guid MovieId { get; set; }
    [SupplyParameterFromQuery(Name = "file")] public Guid MediaFileId { get; set; }
    private MovieDetails? movie;
    private MovieVersion? version;
    private IJSObjectReference? module;
    protected override async Task OnParametersSetAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (Guid.TryParse(
            auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value,
            out var id))
        {
            movie = await MovieLibrary.GetAsync(MovieId, id);
            version = movie?.Versions.FirstOrDefault(item =>
                item.MediaFileId == MediaFileId && item.IsAvailable && item.IsBrowserCompatible);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || version is null || movie is null)
        {
            return;
        }

        module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/moviePlayer.js");
        await module.InvokeVoidAsync(
            "initialize",
            "movie-player",
            MovieId,
            movie.Progress?.TotalSeconds ?? 0,
            movie.ProgressRevision);
    }

    public async ValueTask DisposeAsync()
    {
        if (module is null)
        {
            return;
        }

        try
        {
            await module.InvokeVoidAsync("dispose", "movie-player");
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
