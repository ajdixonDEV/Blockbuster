@page "/movies/{MovieId:guid}"
@attribute [Authorize]
@inject IMovieLibrary MovieLibrary
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@(movie?.Title ?? "Movie") · Blockbuster</PageTitle>
@if (movie is null)
{
    <section class="catalog-empty">
        <p>Movie not found.</p>
    </section>
}
else
{
    <section class="movie-detail">
        @if (movie.BackdropUrl is not null)
        {
            <img
                class="detail-backdrop"
                src="@movie.BackdropUrl"
                alt=""
                draggable="false" />
        }
        <div class="detail-content">
            <div class="detail-poster">
                @if (movie.PosterUrl is not null)
                {
                    <img
                        src="@movie.PosterUrl"
                        alt="Poster for @movie.Title"
                        draggable="false" />
                }
                else
                {
                    <LucideIcon Name="film" Size="56" />
                }
            </div>
            <div>
                <a href="/movies" class="back-link" draggable="false">
                    ← Back to movies
                </a>
                <h1>@movie.Title</h1>
                <p class="movie-meta">
                    @(movie.Year?.ToString() ?? "Year unknown")
                    @if (movie.Genres.Count > 0)
                    {
                        <text> · @string.Join(" · ", movie.Genres)</text>
                    }
                </p>
                <p class="overview">
                    @(movie.Overview ?? "No overview is available.")
                </p>
                <h2>Available versions</h2>
                <div class="version-list">
                    @foreach (var version in movie.Versions)
                    {
                        <article class="version-card">
                            <div>
                                <strong>@version.Quality</strong>
                                <small>@version.FileName</small>
                                @if (!version.IsBrowserCompatible)
                                {
                                    <p class="incompatible">
                                        @version.CompatibilityExplanation
                                    </p>
                                }
                            </div>
                            @if (version.IsAvailable && version.IsBrowserCompatible)
                            {
                                <div class="version-actions">
                                    <a
                                        class="play-link"
                                        href="/movies/@MovieId/play?file=@version.MediaFileId"
                                        draggable="false">
                                        @(movie.Progress is { TotalSeconds: >= 30 }
                                            ? "Resume"
                                            : "Play")
                                    </a>
                                    <form
                                        method="post"
                                        action="/shared/new"
                                        class="shared-create-form">
                                        <AntiforgeryToken />
                                        <input
                                            type="hidden"
                                            name="movie"
                                            value="@MovieId"
                                            draggable="false" />
                                        <input
                                            type="hidden"
                                            name="file"
                                            value="@version.MediaFileId"
                                            draggable="false" />
                                        <button
                                            class="shared-link"
                                            type="submit"
                                            draggable="false">
                                            Start a watch party
                                        </button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <button disabled draggable="false">Unavailable</button>
                            }
                        </article>
                    }
                </div>
            </div>
        </div>
    </section>
}

@code {
    [Parameter]
    public Guid MovieId { get; set; }

    private MovieDetails? movie;

    protected override async Task OnParametersSetAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (Guid.TryParse(
                auth.User.FindFirst(
                    System.Security.Claims.ClaimTypes.NameIdentifier)?.Value,
                out var profileId))
        {
            movie = await MovieLibrary.GetAsync(MovieId, profileId);
        }
    }
}
