@inject NavigationManager Navigation

@code {
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var path = new Uri(Navigation.Uri).AbsolutePath;
        var destination = path.StartsWith("/admin", StringComparison.OrdinalIgnoreCase)
            ? "/admin/login"
            : "/profiles";
        Navigation.NavigateTo(destination, forceLoad: true);
    }
}
