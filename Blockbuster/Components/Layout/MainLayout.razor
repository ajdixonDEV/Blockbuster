@inherits LayoutComponentBase

<div class="app-shell">
    <header class="site-header">
        <a class="brand" href="/" aria-label="Blockbuster home">
            <span class="brand-mark"><LucideIcon Name="ticket" Size="22" /></span>
            <span><strong>Blockbuster</strong><small>Home Video</small></span>
        </a>

        <nav class="primary-nav" aria-label="Primary navigation">
            <NavLink href="movies"><LucideIcon Name="film" Size="17" />Movies</NavLink>
            <NavLink href="tv"><LucideIcon Name="tv" Size="17" />TV</NavLink>
            <NavLink href="videos"><LucideIcon Name="clapperboard" Size="17" />Videos</NavLink>
            <NavLink href="music"><LucideIcon Name="disc-3" Size="17" />Music</NavLink>
        </nav>

        <div class="profile-action">
            <BbBadge Variant="BadgeVariant.Outline" Class="server-badge">
                <span class="online-dot"></span>Server online
            </BbBadge>
            <AuthorizeView>
                <Authorized Context="profileState"><a class="profile-link" href="/profiles"><BbAvatar Size="AvatarSize.Small"><BbAvatarFallback>@profileState.User.Identity?.Name?[0]</BbAvatarFallback></BbAvatar>@profileState.User.Identity?.Name</a><form method="post" action="/auth/profile/clear" class="session-action"><button type="submit">Sign out</button></form></Authorized>
                <NotAuthorized><a class="profile-link" href="/profiles"><BbAvatar Size="AvatarSize.Small"><BbAvatarFallback>?</BbAvatarFallback></BbAvatar>Choose profile</a></NotAuthorized>
            </AuthorizeView>
            <a class="admin-link" href="/admin" data-enhance-nav="false" aria-label="Administration" title="Administration"><LucideIcon Name="settings" Size="17" /></a>
        </div>
    </header>

    <main>@Body</main>

    <footer class="site-footer">
        <span>Blockbuster Home Video</span>
        <span>A private vault of family-owned media. · <a href="/about">About &amp; credits</a></span>
    </footer>
</div>

<BbPortalHost />
