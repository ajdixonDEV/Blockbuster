@inherits LayoutComponentBase

<a class="skip-link" href="#main-content" draggable="false">Skip to main content</a>
<div class="app-shell">
    <header class="site-header">
        <a class="brand" href="/" aria-label="Blockbuster home" draggable="false">
            <span class="brand-mark">
                <LucideIcon Name="ticket" Size="22" />
            </span>
            <span>
                <strong>Blockbuster</strong>
                <small>Home Video</small>
            </span>
        </a>
        <nav class="primary-nav" aria-label="Primary navigation">
            <NavLink href="movies" draggable="false">
                <LucideIcon Name="film" Size="17" />Movies
            </NavLink>
            <NavLink href="tv" draggable="false">
                <LucideIcon Name="tv" Size="17" />TV
            </NavLink>
            <NavLink href="videos" draggable="false">
                <LucideIcon Name="clapperboard" Size="17" />Videos
            </NavLink>
            <NavLink href="music" draggable="false">
                <LucideIcon Name="disc-3" Size="17" />Music
            </NavLink>
            <NavLink href="shared" draggable="false">
                <LucideIcon Name="users" Size="17" />Shared
            </NavLink>
        </nav>
        <div class="profile-action">
            <BbBadge Variant="BadgeVariant.Outline" Class="server-badge">
                <span class="online-dot">
                </span>Server online
            </BbBadge>
            <AuthorizeView>
                <Authorized Context="profileState">
                    <a class="profile-link" href="/profiles" draggable="false">
                        <BbAvatar Size="AvatarSize.Small">
                            <BbAvatarFallback>@profileState.User.Identity?.Name?[0]</BbAvatarFallback>
                        </BbAvatar>@profileState.User.Identity?.Name
                    </a>
                    <form method="post"
                          action="@(profileState.User.HasClaim("administrator", "true") ? "/auth/admin/logout" : "/auth/profile/clear")"
                          class="session-action">
                        <AntiforgeryToken />
                        <button type="submit" draggable="false">Sign out</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a class="profile-link" href="/profiles" draggable="false">
                        <BbAvatar Size="AvatarSize.Small">
                            <BbAvatarFallback>?</BbAvatarFallback>
                        </BbAvatar>Choose profile
                    </a>
                </NotAuthorized>
            </AuthorizeView>
            <a class="admin-link" href="/admin" data-enhance-nav="false" aria-label="Administration" title="Administration" draggable="false">
                <LucideIcon Name="settings" Size="17" />
            </a>
        </div>
    </header>
    <main id="main-content" tabindex="-1">@Body</main>
    <footer class="site-footer">
        <span>Blockbuster Home Video</span>
        <span>
            A private vault of family-owned media. · <a href="/about" draggable="false">About &amp; credits</a>
        </span>
    </footer>
</div>
<BbPortalHost />
