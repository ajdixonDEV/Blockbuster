<div class="player-shell @(Shared ? "shared-player" : "")" id="@PlayerId">
    <video src="@Source" preload="metadata" aria-label="@AccessibleTitle"></video>
    @if (Shared)
    {
        <button class="join-room-overlay" data-action="join">Join room and synchronize</button>
    }
    <div class="player-status" aria-live="polite"></div>
    <div class="player-controls">
        <button data-action="play" aria-label="Play" aria-pressed="false">▶</button>
        <span data-current aria-label="Current time">0:00</span>
        <input data-seek type="range" min="0" max="0" value="0" step="0.1" aria-label="Seek" />
        <span data-duration aria-label="Duration">0:00</span>
        <button data-action="mute" aria-label="Mute" aria-pressed="false">🔊</button>
        <input data-volume type="range" min="0" max="1" step="0.05" value="1" aria-label="Volume" />
        <button data-action="fullscreen" aria-label="Enter fullscreen" aria-pressed="false">⛶</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string PlayerId { get; set; } = "";
    [Parameter, EditorRequired] public string Source { get; set; } = "";
    [Parameter, EditorRequired] public string AccessibleTitle { get; set; } = "";
    [Parameter] public bool Shared { get; set; }
}
