{
  "AllowedHosts": "*",
  "Storage": {},
  "Libraries": {
    "Sources": []
  },
  "Scanning": {
    "ScanOnStartup": true,
    "Interval": "06:00:00",
    "Extensions": [ ".mp4", ".m4v", ".mkv", ".webm", ".avi", ".mov" ],
    "Concurrency": 2
  },
  "MediaProbe": {
    "ExecutablePath": "ffprobe",
    "Timeout": "00:00:30"
  },
  "Tmdb": {
    "Locale": "en-US",
    "PosterSize": "w500",
    "BackdropSize": "w1280",
    "RequireMatchingYear": true,
    "RequireUniqueMatch": true
  },
  "Playback": {
    "ProgressInterval": "00:00:10",
    "ResumeThreshold": "00:00:30",
    "PreferBrowserCompatibleVersions": true
  },
  "History": {
    "MaximumEventsPerProfile": 100
  },
  "Rooms": {
    "EmptyRoomExpiry": "00:05:00",
    "DriftCheckInterval": "00:00:05",
    "RateCorrectionThreshold": "00:00:00.750",
    "HardSeekThreshold": "00:00:03"
  },
  "Authentication": {
    "AdminCookieLifetime": "08:00:00"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
